# =============================================================================
# AI-Enhanced Video Meeting PoC - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# Do NOT commit .env to version control
#
# Quick Start:
# 1. cp .env.example .env
# 2. Generate secrets (see below)
# 3. Add your KIMI K2 API key
# 4. Update passwords
# 5. Run: docker-compose up -d

# =============================================================================
# SECRET GENERATION COMMANDS
# =============================================================================
# Generate JWT secret:
#   openssl rand -hex 32
#
# Generate LiveKit API secret:
#   openssl rand -base64 48
#
# Generate strong password:
#   openssl rand -base64 24

# =============================================================================
# General
# =============================================================================
APP_ENV=development
# Options: development, staging, production
# In production, set to 'production' and disable DEBUG

DEBUG=true
# Enable debug logging and verbose error messages
# In production, set to 'false'

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Frontend
# =============================================================================
FRONTEND_PORT=3000
# Port for frontend container (Nginx inside container listens on 80)

VITE_API_BASE_URL=http://localhost:8000/api
# Backend API URL (accessed by browser, not container)
# Production: https://yourdomain.com/api

VITE_WS_URL=ws://localhost:8000
# WebSocket URL for real-time updates
# Production: wss://yourdomain.com

VITE_LIVEKIT_URL=ws://localhost:7880
# LiveKit server URL (accessed by browser)
# Production: wss://yourdomain.com:7880 or wss://livekit.yourdomain.com

# =============================================================================
# Backend (FastAPI)
# =============================================================================
BACKEND_PORT=8000
# Port for backend container

BACKEND_HOST=0.0.0.0
# Bind address (0.0.0.0 allows external connections)

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated list of allowed origins for CORS
# Include both production and dev ports
# Production: https://yourdomain.com

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres
# Hostname (use 'postgres' for Docker Compose, 'localhost' for local dev)

POSTGRES_PORT=5432
# PostgreSQL port

POSTGRES_DB=meeting_ai
# Database name

POSTGRES_USER=postgres
# Database user

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Database password
# IMPORTANT: Change this to a strong password!
# Generate with: openssl rand -base64 24

# =============================================================================
# Redis (Message Broker & Cache)
# =============================================================================
REDIS_HOST=redis
# Hostname (use 'redis' for Docker Compose)

REDIS_PORT=6379
# Redis port

REDIS_PASSWORD=
# Redis password (leave empty for no auth in development)
# Production: set a strong password

# =============================================================================
# LiveKit
# =============================================================================
LIVEKIT_HOST=livekit
# Hostname (use 'livekit' for Docker Compose)

LIVEKIT_PORT=7880
# WebSocket port for client connections

LIVEKIT_PORT_HTTP=7881
# HTTP API port for server SDK

LIVEKIT_API_KEY=devkey
# LiveKit API key
# IMPORTANT: Change this in production!
# Generate with: openssl rand -hex 16

LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET
# LiveKit API secret
# IMPORTANT: Change this to a strong secret!
# Generate with: openssl rand -base64 48

# =============================================================================
# STT (Speech-To-Text) - WhisperLive
# =============================================================================
STT_ENGINE_TYPE=whisperlive
# Engine type (whisperlive, vosk, etc.)
# Currently only whisperlive is implemented

STT_HOST=stt
# Hostname (use 'stt' for Docker Compose)

STT_PORT=9090
# WebSocket port for STT service

STT_MODEL=large-v3
# Whisper model size
# Options: tiny, base, small, medium, large-v3
# Smaller = faster but less accurate
# large-v3 = best accuracy but slower
# Recommendation: medium for CPU, large-v3 for GPU

STT_LANGUAGE=en
# Primary language (ISO 639-1 code)
# Options: en, es, fr, de, zh, ja, etc.
# Leave empty for auto-detection

STT_BACKEND=faster_whisper
# STT backend engine
# Options: faster_whisper, tensorrt, openvino
# faster_whisper works on both CPU and GPU

STT_DEVICE=cpu
# Compute device
# Options: cpu, cuda
# Use 'cuda' if you have NVIDIA GPU

STT_COMPUTE_TYPE=int8
# Precision/compute type
# Options: int8 (fastest, CPU), float16 (GPU), float32 (highest quality)
# int8 recommended for CPU, float16 for GPU

# =============================================================================
# LLM (Large Language Model) - KIMI K2
# =============================================================================
LLM_PROVIDER=kimi_k2
# Provider name (fixed for this PoC)

LLM_API_BASE_URL=https://platform.moonshot.ai/v1
# KIMI K2 API base URL
# This is the official Moonshot AI endpoint

LLM_API_KEY=sk-CHANGE_ME_YOUR_KIMI_K2_API_KEY
# KIMI K2 API key
# REQUIRED: Get from https://platform.moonshot.ai
# Format: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_MODEL=kimi-k2-instruct
# Model name
# Options: kimi-k2-instruct (general), kimi-k2-thinking (reasoning)
# kimi-k2-instruct recommended for this use case

LLM_TEMPERATURE=0.7
# Sampling temperature (0.0-2.0)
# Lower = more deterministic, Higher = more creative
# 0.7 is a good balance for meeting analysis

LLM_MAX_TOKENS=2000
# Max tokens per LLM response
# 2000 is sufficient for thought board updates

LLM_REQUEST_TIMEOUT=30
# Request timeout in seconds
# Increase if experiencing timeouts

LLM_MIN_REQUEST_INTERVAL=5
# Minimum seconds between LLM API requests
# Prevents rate limiting and reduces costs
# Thought board updates at most every 5 seconds

# =============================================================================
# Authentication & Security
# =============================================================================
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
# Secret key for signing JWT tokens
# CRITICAL: Change this to a strong random string!
# Generate with: openssl rand -hex 32
# Minimum 32 characters recommended

JWT_ALGORITHM=HS256
# JWT signing algorithm
# Options: HS256 (symmetric), RS256 (asymmetric)
# HS256 is simpler and sufficient for this PoC

JWT_EXPIRATION_MINUTES=1440
# JWT token expiration time in minutes
# 1440 = 24 hours
# Adjust based on security requirements

PASSWORD_MIN_LENGTH=8
# Minimum password length for user accounts

BCRYPT_ROUNDS=12
# Bcrypt cost factor (10-14 recommended)
# Higher = more secure but slower
# 12 is a good balance for 2025

# =============================================================================
# Admin User (Initial Seed Data)
# =============================================================================
ADMIN_DEFAULT_USERNAME=admin
# Default admin username for initial setup
# Used by database seed script

ADMIN_DEFAULT_PASSWORD=CHANGE_ME_admin123
# Default admin password
# IMPORTANT: Change this immediately after first login!
# Only used for initial database seeding

ADMIN_DEFAULT_EMAIL=admin@example.com
# Default admin email
# Used for future password reset features

# =============================================================================
# Nginx (Reverse Proxy) - Production Only
# =============================================================================
NGINX_PORT_HTTP=80
# HTTP port (redirects to HTTPS in production)

NGINX_PORT_HTTPS=443
# HTTPS port

DOMAIN=localhost
# Your domain name
# Development: localhost
# Production: yourdomain.com or meeting.yourdomain.com

SSL_CERT_PATH=/etc/letsencrypt/live/${DOMAIN}/fullchain.pem
# SSL certificate path (for Let's Encrypt)
# Only needed in production

SSL_KEY_PATH=/etc/letsencrypt/live/${DOMAIN}/privkey.pem
# SSL private key path
# Only needed in production

# =============================================================================
# Feature Flags (Future Extensions)
# =============================================================================
ENABLE_VIDEO_ANALYTICS=false
# Enable video analytics module (facial expressions, gaze, etc.)
# Not implemented in PoC - placeholder for future

ENABLE_AUDIO_ANALYTICS=false
# Enable audio analytics module (emotion detection, tone, etc.)
# Not implemented in PoC - placeholder for future

ENABLE_RECORDING=false
# Enable meeting recording
# Not implemented in PoC - placeholder for future

# =============================================================================
# Development Settings (Optional)
# =============================================================================
# Uncomment these for local development outside Docker

# DATABASE_URL=postgresql+asyncpg://postgres:changeme123@localhost:5432/meeting_ai
# REDIS_URL=redis://localhost:6379/0
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_URL=http://localhost:7881
# STT_URL=ws://localhost:9090
